{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面端默认权限集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://*/*" }]
    }
  ]
}
