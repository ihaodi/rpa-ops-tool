{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "桌面端默认权限集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*:*" },
        { "url": "http://**:*" },
        { "url": "http://*:*/*" },
        { "url": "http://**:*/*" },
        { "url": "https://*:*" },
        { "url": "https://**:*" },
        { "url": "*://*:*/*" }
      ]
    }
  ]
}
